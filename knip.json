{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["files", "dependencies", "exports"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["gh"],
  "ignoreDependencies": ["@mold/ui", "tailwindcss"],
  "ignoreFiles": ["docs/**", "website/**", "result*", "result*/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/tests/android-app-smoke.mjs"],
      "project": ["scripts/**/*.{js,mjs,cjs,ts}"]
    },
    "studio": {
      "entry": [
        "index.ts",
        "components/MeshWorkflowStudio.vue",
        "components/MeshWorkflowHostPicker.vue",
        "components/HeldQueueTransferDialog.vue",
        "**/*.test.ts"
      ],
      "project": ["**/*.{ts,vue}"]
    },
    "ui": {
      "entry": ["**/*.test.ts", "components/**/*.vue", "icons.ts", "theme.ts"],
      "project": ["**/*.{ts,vue}"]
    },
    "web": {
      "entry": ["src/main.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,vue}"]
    },
    "desktop": {
      "entry": [
        "src/main.ts",
        "src/mobile/main.ts",
        "src/**/*.test.ts",
        "vite.mobile.config.ts"
      ],
      "project": ["src/**/*.{ts,vue}"]
    }
  }
}
