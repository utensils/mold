{
  "name": "mold-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build && node scripts/verify-pairing-build.mjs",
    "preview": "vitepress preview",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "verify": "bun run scripts/verify-docs.mjs && bun test scripts/pairing-page.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "proseWrap": "always",
    "printWidth": 80,
    "overrides": [
      {
        "files": "**/*.md",
        "options": {
          "proseWrap": "preserve"
        }
      }
    ]
  }
}
