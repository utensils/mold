{
  "name": "mold-frontend-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "studio",
    "ui",
    "web",
    "desktop"
  ],
  "scripts": {
    "fmt": "prettier --write studio",
    "fmt:check": "prettier --check studio",
    "check:architecture": "bash scripts/tests/frontend-architecture.sh",
    "check:dead-code": "knip",
    "test:studio": "vitest run --config studio/vitest.config.ts",
    "test:web": "cd web && bun run test",
    "test:desktop": "cd desktop && bun run test",
    "build:web": "cd web && bun run build",
    "build:desktop": "cd desktop && bun run build",
    "build:mobile": "cd desktop && bun run build:mobile",
    "check:frontend": "bun run check:architecture && bun run test:studio && bun run test:web && bun run test:desktop && bun run build:web && bun run build:desktop"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/vue-virtual": "3.13.31",
    "pinia": "3.0.4",
    "qrcode": "1.5.4",
    "smol-toml": "1.7.0",
    "vue": "3.5.39",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "@types/qrcode": "1.5.6",
    "happy-dom": "20.10.6",
    "knip": "5.68.0",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
