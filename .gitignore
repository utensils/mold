# Local-only AI-assisted dev scaffolding (handoffs, phase plans, design docs).
# Kept on disk for session context; not part of the public repo.
# (Committed, code-referenced design specs are re-included below; a file that
# is both tracked and ignored makes release-plz refuse to run.)
tasks/
docs/superpowers/*
!docs/superpowers/specs/
docs/superpowers/specs/*
!docs/superpowers/specs/2026-07-03-durable-chain-jobs-design.md
.worktrees/
.playwright-mcp/
.direnv/

# Frontend workspace dependencies live at the repo root.
/node_modules/
/*/node_modules/

# Tauri frontend bundles
desktop/dist/
desktop/dist-mobile/

# Website
website/node_modules/
website/.vitepress/cache/
website/.vitepress/dist/

# Web gallery SPA (crates/mold-server serves it from web/dist/)
# Root bun.lock and bun.nix are committed for reproducible builds.
web/dist/
web/.vite/
web/*.tsbuildinfo
.DS_Store
.env
.secrets/
*.jpeg
*.jpg
*.png
# Allow committed images in docs and website
!docs/**/*.png
!website/public/**/*.png
!web/public/**/*.png
!desktop/src/assets/**/*.png
!docs/design/**/*.jpg
!docs/design/**/*.png
!apps/mobile/src-tauri/app-icon.png
!apps/mobile/src-tauri/gen/apple/Assets.xcassets/**/*.png
!apps/mobile/src-tauri/gen/android/app/src/main/res/mipmap-*/**/*.png
!crates/mold-inference/src/ltx2/testdata/preprocess/*.jpg
!crates/mold-inference/src/ltx2/testdata/preprocess/*.png
# PuLID face-extraction parity fixtures (#1222): public-domain portraits and
# the warp goldens captured from them. Un-ignored rather than force-added,
# because release-plz refuses to run while a tracked file is also gitignored.
!crates/mold-inference/testdata/pulid/faces/*.jpg
!crates/mold-inference/testdata/pulid/faces/*.png
apps/mobile/src-tauri/gen/schemas/
result
result-*
*.swo
*.swp
# mold runpod run default output dir
mold-outputs/
**/target
/target
/target/coverage/
tmp/
uat-*
*.gif
*.apng
*.webp
*.mp4
# HDR renders write one EXR per frame, so a single short clip is tens of
# megabytes across dozens of files.
*.exr
*.zip
.superpowers/

# Catalog tests write sidecar fixtures next to the crate root when they run
# with a relative models dir; they are scratch, never sources.
crates/*/cv-*/
# CLI tests that exercise the real download path write a HF cache and a model
# directory next to the crate root. Both are scratch.
crates/*/.hf-cache/
crates/mold-cli/ltx2-control-union-19b/

# Python bytecode from the contract scripts under scripts/
__pycache__/
*.pyc
