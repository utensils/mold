{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mold",
  "version": "0.21.0",
  "identifier": "com.utensils.mold",
  "build": {
    "beforeDevCommand": "bash -c 'cd ../../desktop && bun run dev:mobile'",
    "beforeBuildCommand": "bash -c 'cd ../../desktop && bun run build:mobile'",
    "devUrl": "http://localhost:1431",
    "frontendDist": "../../../desktop/dist-mobile"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mold"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "mold"
          ],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../desktop/src-tauri/icons/icon.png"
    ],
    "publisher": "James Brink and Jeffrey Dilley",
    "copyright": "Copyright \u00a9 2026 James Brink and Jeffrey Dilley. MIT License.",
    "category": "GraphicsAndDesign",
    "shortDescription": "Generate with remote Mold hosts from iPhone.",
    "longDescription": "Mold for iPhone connects to remote Mold engines over your LAN or Tailscale for generation, gallery, model catalog, host monitoring, and appearance settings.",
    "iOS": {
      "developmentTeam": "28X9H69QGE",
      "minimumSystemVersion": "17.0"
    }
  }
}
