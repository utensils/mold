<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- mold servers speak plain HTTP. They live on a LAN, on Tailscale, or on
	     loopback when the engine is embedded, and none of those have a
	     certificate a device would trust. ATS would refuse every one of them,
	     so the exception is the feature working rather than a shortcut.

	     This IS as narrow as ATS goes for this app, and the narrower form is a
	     trap rather than an improvement (review 05-M15, 04-L3). Apple's own
	     rule: on macOS 10.12+ `NSAllowsArbitraryLoads` is IGNORED whenever
	     `NSAllowsLocalNetworking` is present -- the pair exists so an old OS
	     gets the blanket and a new one gets local networking only. On macOS 26
	     adding it would therefore switch cleartext back ON for `.local`,
	     loopback and unqualified names, and OFF for everything else — and a
	     mold reached by its Tailscale MagicDNS NAME (`box.tailXXXX.ts.net`) is
	     none of those, so the app's own case would break. (A bare IP is the
	     weaker half of this argument: ATS does not apply to a literal address
	     at all. The name case is what carries it.) The same applies to
	     `NSExceptionDomains`: under a blanket they are inert, and without one
	     they cannot enumerate an address someone types.

	     Two consequences worth knowing rather than hiding. An operator key
	     sent to an `http://` host travels in cleartext, on whatever network
	     that host is on. And a blanket relaxes CLEARTEXT, never certificate
	     validation, so an `https://` mold with a self-signed or private-CA
	     certificate is still unreachable and there is no `URLSessionDelegate`
	     to opt into one. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>Utensils</string>
	<!-- Sparkle. The feed here is the STABLE one and it is the default; the
	     nightly feed is chosen at runtime by `UpdateFeedDelegate`, which is
	     the supported way to move an app between channels (`SUFeedURL` on the
	     updater is deprecated in Sparkle 2, the delegate's
	     `feedURLString(for:)` is not). Both URLs are pinned by
	     `UpdateFeedTests`, and this one again by `assert-sparkle-key.sh`.

	     GitHub Releases only, exactly like the Tauri app's two manifests
	     (`desktop/src-tauri/src/updater.rs:23-26`). No gh-pages, no
	     utensils.io. -->
	<key>SUFeedURL</key>
	<string>https://github.com/utensils/mold/releases/latest/download/mold-native-appcast.xml</string>
	<!-- Substituted from the build setting of the same name. A Release whose
	     value is still the placeholder is refused before signing. -->
	<key>SUPublicEDKey</key>
	<string>$(MOLD_SPARKLE_PUBLIC_ED_KEY)</string>
	<!-- Once a day when the user has agreed to automatic checks. Sparkle asks
	     on the first check rather than assuming, so `SUEnableAutomaticChecks`
	     is deliberately absent. -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Hosts are reached over the LAN and over Tailscale, so macOS will ask
	     for local network permission on first connection. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mold connects to mold servers on your local network.</string>
	<!-- The mold home can live on an external drive, which macOS treats as a
	     removable volume and gates behind its own permission. -->
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Mold keeps its models, prints and settings in your mold home, which is on this volume.</string>
	<!-- A print dragged inside Mold travels as its identity, so a drop onto a
	     collection accepts prints and not every JSON file on the disk. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.utensils.mold.print</string>
			<key>UTTypeDescription</key>
			<string>Mold Print</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- The engine drains on quit; sudden termination would cut a publish. -->
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
