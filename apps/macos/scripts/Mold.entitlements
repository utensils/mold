<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- RELEASE. `Mold.Debug.entitlements` is the dev twin and is strictly wider;
     `project.yml` picks per configuration. They were one file, so a shipped
     build carried an exemption whose stated reason was a DEBUG-only path
     (review F7). -->
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the app reaches arbitrary machines on the LAN and over
	     Tailscale, and the embedded engine owns a models directory the user
	     points at. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Candle compiles its Metal shaders at RUNTIME from source strings. The
	     usual reading is that this is therefore needed; the usual reading may
	     be wrong, because `MTLDevice.makeLibrary(source:)` compiles out of
	     process in the Metal compiler XPC service and the result is loaded as
	     GPU code, not as CPU-executable pages — hardened Metal apps normally
	     ship with none of these. It is kept only because nobody has yet
	     watched a signed build render.
	     The check owed, exactly: remove this key, `make signed`, launch the
	     signed Release bundle, run one local render on Metal, and confirm no
	     `EXC_BAD_ACCESS` and nothing in ~/Library/Logs/Mold about shader
	     compilation. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Strictly broader than allow-jit: it removes the MAP_JIT requirement
	     process-wide, which is the mitigation allow-jit exists to preserve.
	     Kept on the same terms and owing the same check, which should be run
	     for this key FIRST — if a signed Metal render works without it, this
	     one goes whatever happens to allow-jit. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- `com.apple.security.cs.disable-library-validation` is deliberately
	     ABSENT here. The reason it used to carry — "the embedded engine links
	     libc++ from the Nix store" — is gone: `fix-macos-native-linkage.sh`
	     retargets those loads to /usr/lib before signing and fails the release
	     if any survive. The only surviving reason was the DEBUG path, which is
	     in the Debug file. -->
</dict>
</plist>
