# Mold for macOS. `make` is the only entry point -- Mold.xcodeproj is
# generated from project.yml and is never checked in.

SHELL := /bin/bash
.DEFAULT_GOAL := help

XCODEGEN ?= xcodegen
PROJECT  := Mold.xcodeproj
SCHEME   := Mold
CONFIG   ?= Debug
BUILD    := $(CURDIR)/build
APP      := $(BUILD)/$(CONFIG)/Mold.app

# Dev builds are signed with a real identity when this Mac has one, so the
# app keeps ONE identity across rebuilds and macOS remembers its answers --
# ad-hoc signing made every build a new app to TCC, and the "removable
# volume" prompt came back on every launch. Falls back to ad-hoc where there
# is no identity, so `make build` still works on a machine without one.
MOLD_DEV_SIGN_IDENTITY ?= $(shell security find-identity -v -p codesigning 2>/dev/null \
  | grep -oE '"(Developer ID Application: [^"]+|Apple Development: [^"]+)"' \
  | sort -t'"' -k2,2r | head -1 | tr -d '"')
SIGN := CODE_SIGN_IDENTITY="$(or $(MOLD_DEV_SIGN_IDENTITY),-)"

XCB      := xcodebuild -project $(PROJECT) -scheme $(SCHEME) -configuration $(CONFIG) \
            -derivedDataPath $(BUILD)/DerivedData CONFIGURATION_BUILD_DIR=$(BUILD)/$(CONFIG) $(SIGN)

.PHONY: help gen build run uat test lint lint-layers lint-color lint-size lint-type-size clean \
        engine engine-clean engine-config signed dmg notarize release

help: ## Show this help
	@grep -hE '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | \
	  awk 'BEGIN{FS=":.*?## "}{printf "  \033[1m%-12s\033[0m %s\n", $$1, $$2}'

ENGINE_DIR := $(CURDIR)/rust/mold-macos-ffi
ENGINE_TARGET ?= /Volumes/ExternalStorage/cargo-targets/mold-macos-ffi
ENGINE_LIB := $(ENGINE_TARGET)/release/libmold_macos_ffi.a

engine: ## Build mold's Rust engine and link it into the app
	@command -v cargo >/dev/null || { echo "cargo not found -- run inside 'nix develop'"; exit 1; }
	@# Same deployment target as the app, or every object file warns.
	@cd $(ENGINE_DIR) && CARGO_TARGET_DIR=$(ENGINE_TARGET) CARGO_BUILD_JOBS=8 \
	  MACOSX_DEPLOYMENT_TARGET=26.0 cargo build --release --features metal
	@$(MAKE) engine-config
	@echo "  engine linked: $(ENGINE_LIB)"

engine-config: ## Point Engine.xcconfig at a built staticlib, or clear it
	@# The link line is cargo's own answer (`--print native-static-libs`), not a
	@# guess: fdk-aac is a C library the Rust archive does NOT bundle, so
	@# omitting it fails at link with five undefined AAC symbols.
	@if [ -f "$(ENGINE_LIB)" ]; then \
	  fdk=$$(find $(ENGINE_TARGET)/release/build -name 'libfdk-aac.a' -print -quit 2>/dev/null); \
	  fdkdir=$${fdk:+-L$$(dirname $$fdk)}; \
	  printf '%s\n' \
	    '// Generated by `make engine`. Do not edit.' \
	    'MOLD_ENGINE_LIB = $(ENGINE_LIB)' \
	    "OTHER_LDFLAGS = \$$(inherited) \$$(MOLD_ENGINE_LIB) $$fdkdir -lfdk-aac -lc++ -lobjc -liconv -lm -framework Metal -framework Foundation -framework CoreFoundation -framework IOKit -framework SystemConfiguration" \
	    'SWIFT_ACTIVE_COMPILATION_CONDITIONS = $$(inherited) MOLD_EMBEDDED_ENGINE' \
	    > Engine.xcconfig; \
	  echo "  Engine.xcconfig -> linked"; \
	else \
	  printf '%s\n' '// Generated by `make engine-config`. No engine built; remote-only.' > Engine.xcconfig; \
	  echo "  Engine.xcconfig -> remote only"; \
	fi

engine-clean: ## Unlink the engine and go back to a remote-only build
	@printf '%s\n' '// Generated by `make engine-config`. No engine built; remote-only.' > Engine.xcconfig
	@echo "  engine unlinked"

gen: ## Regenerate Mold.xcodeproj from project.yml
	@command -v $(XCODEGEN) >/dev/null || { echo "xcodegen not found -- run inside 'nix develop'"; exit 1; }
	@$(XCODEGEN) generate --spec project.yml --quiet

build: gen ## Build the app
	@$(XCB) build | grep -Ev '^\s*$$' | tail -5

run: build ## Build and launch the app
	@open $(APP)

# TMPDIR carries its trailing slash on macOS; `or` covers a shell that has none.
UAT_HOME ?= $(or $(TMPDIR),/tmp/)mold-native-uat

uat: build ## Launch against a throwaway prefs domain and a throwaway mold home
	@# Everything this run touches is disposable, so a UAT can exercise
	@# onboarding, a first launch and an empty library without costing anyone
	@# their machine list, their models or their prints. `make run` is the
	@# opposite by design: it uses the real settings and the real home.
	@defaults delete io.utensils.mold.native.fresh 2>/dev/null || true
	@rm -rf "$(UAT_HOME)" && mkdir -p "$(UAT_HOME)"
	@echo "  prefs: io.utensils.mold.native.fresh (emptied)"
	@echo "  home:  $(UAT_HOME) (emptied -- the engine starts here with no models)"
	@MOLD_NATIVE_FRESH=1 MOLD_HOME="$(UAT_HOME)" \
	  ./build/$(CONFIG)/Mold.app/Contents/MacOS/Mold

test: gen ## Run every test bundle: the package, then the app's own store tests
	@cd Packages/MoldClient && swift test
	@$(XCB) -destination 'platform=macOS,arch=arm64' test | grep -Ev '^\s*$$' | tail -5

lint: lint-layers lint-color lint-size lint-type-size ## Run every architecture lint

lint-layers: ## MoldClient stays UI-free; only the root may build a backend
	@# MoldStyle is the design system and of course imports SwiftUI. MoldClient
	@# is the wire layer: it must stay usable from tests and from a CLI, so a UI
	@# import there is the violation worth catching.
	@! grep -rlnE '^import (SwiftUI|AppKit)' Packages/MoldClient/Sources \
	  || { echo "LAYER VIOLATION: MoldClient imports a UI framework"; exit 1; }
	@! grep -rln 'HTTPBackend(' Sources --include='*.swift' \
	  | grep -v 'HostStore+Reachability.swift' \
	  || { echo "LAYER VIOLATION: a backend is constructed outside the composition root"; exit 1; }
	@# One decoder configures snake_case conversion. A bare JSONDecoder()
	@# silently decodes every multi-word field as nil rather than failing.
	@! grep -rn 'JSONDecoder()' Sources Packages/*/Sources Packages/*/Tests --include='*.swift' \
	  | grep -v 'MoldJSON.swift' \
	  || { echo "DECODER VIOLATION: use MoldJSON.decoder"; exit 1; }
	@# URLSession's `.lines` drops empty lines, and an empty line is what ends an
	@# SSE frame. `moldLines()` is the accumulator that keeps them.
	@! grep -rn 'bytes\.lines' Packages/MoldClient/Sources --include='*.swift' \
	  || { echo "SSE VIOLATION: use bytes.moldLines()"; exit 1; }
	@echo "  layers ok"

lint-color: ## No literal colors -- the system owns the palette
	@! grep -rnE 'Color\((red|hue|white):|Color\(hex' Sources Packages/*/Sources --include='*.swift' \
	  || { echo "COLOR VIOLATION: use a semantic color or a material"; exit 1; }
	@echo "  color ok"

lint-size: ## Advisory: flag files over 150 lines
	@find Sources Packages/*/Sources -name '*.swift' -exec wc -l {} + \
	  | awk '$$1 > 150 && $$2 != "total" { print "  large: " $$2 " (" $$1 " lines)" }'

# A type's size is the sum of Type.swift and every Type+Concern.swift beside
# it. Splitting a 400-line type into three files does not make it smaller, and
# `lint-size` alone cannot see that.
TYPE_MAX ?= 600

lint-type-size: ## Advisory: flag a type whose files together exceed $(TYPE_MAX) lines
	@find Sources Packages/*/Sources -name '*.swift' -exec wc -l {} + \
	  | awk -v max=$(TYPE_MAX) '$$2 != "total" { \
	      name = $$2; sub(/.*\//, "", name); sub(/\.swift$$/, "", name); sub(/\+.*$$/, "", name); \
	      total[name] += $$1 } \
	    END { for (t in total) if (total[t] > max) \
	      printf "  large type: %s (%d lines across its files)\n", t, total[t] }' \
	  | sort

VERSION ?= 0.1.0
DIST := $(CURDIR)/dist
RELEASE_APP := $(BUILD)/Release/Mold.app

signed: ## Release build, signed for distribution (needs MOLD_SIGN_IDENTITY)
	@CONFIG=Release $(MAKE) build
	@scripts/sign-release.sh "$(RELEASE_APP)"

dmg: ## Package the signed app as a DMG
	@mkdir -p $(DIST)
	@scripts/create-dmg.sh "$(RELEASE_APP)" "$(DIST)/Mold-$(VERSION).dmg"

notarize: ## Notarize and staple the DMG
	@scripts/notarize-release.sh "$(DIST)/Mold-$(VERSION).dmg"

release: signed dmg notarize ## Sign, package and notarize in one go
	@echo "released: $(DIST)/Mold-$(VERSION).dmg"

clean: ## Remove build output and the generated project
	@rm -rf $(BUILD) $(PROJECT) $(DIST) Packages/*/.build
