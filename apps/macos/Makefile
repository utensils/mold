# Mold for macOS. `make` is the only entry point -- Mold.xcodeproj is
# generated from project.yml and is never checked in.

SHELL := /bin/bash
.DEFAULT_GOAL := help

XCODEGEN ?= xcodegen
PROJECT  := Mold.xcodeproj
SCHEME   := Mold
CONFIG   ?= Debug
BUILD    := $(CURDIR)/build
APP      := $(BUILD)/$(CONFIG)/Mold Studio.app

# Dev builds are signed with a real identity when this Mac has one, so the
# app keeps ONE identity across rebuilds and macOS remembers its answers --
# ad-hoc signing made every build a new app to TCC, and the "removable
# volume" prompt came back on every launch. Falls back to ad-hoc where there
# is no identity, so `make build` still works on a machine without one.
MOLD_DEV_SIGN_IDENTITY ?= $(shell security find-identity -v -p codesigning 2>/dev/null \
  | grep -oE '"(Developer ID Application: [^"]+|Apple Development: [^"]+)"' \
  | sort -t'"' -k2,2r | head -1 | tr -d '"')
SIGN := CODE_SIGN_IDENTITY="$(or $(MOLD_DEV_SIGN_IDENTITY),-)"

# Sparkle decides which build is newer by comparing CFBundleVersion, and it
# compares across BOTH channels -- a nightly and a stable are the same app.
# A hand-bumped number cannot be trusted to rise, so it is the commit count:
# monotonic on main by construction, identical for a stable and a nightly cut
# from the same commit, and never a decision anybody has to remember to make.
# (A nightly ahead of the last release therefore reads as newer than it, which
# is correct: moving back to Stable waits for a release newer than that count.)
BUILD_NUMBER ?= $(shell git rev-list --count HEAD 2>/dev/null || echo 1)

XCB      := xcodebuild -project $(PROJECT) -scheme $(SCHEME) -configuration $(CONFIG) \
            -derivedDataPath $(BUILD)/DerivedData CONFIGURATION_BUILD_DIR=$(BUILD)/$(CONFIG) $(SIGN) \
            CURRENT_PROJECT_VERSION=$(BUILD_NUMBER) \
            MARKETING_VERSION=$(MARKETING_VERSION)

.PHONY: help gen build run uat test lint lint-layers lint-color lint-size lint-type-size lint-a11y clean \
        engine engine-clean engine-config signed dmg notarize release appcast

help: ## Show this help
	@grep -hE '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) | \
	  awk 'BEGIN{FS=":.*?## "}{printf "  \033[1m%-12s\033[0m %s\n", $$1, $$2}'

ENGINE_DIR := $(CURDIR)/rust/mold-macos-ffi
# In-repo and gitignored by default, so `make engine` works on any Mac. It is
# tens of GB and rebuilt often, so point it at another volume if this disk is
# the one you care about:
#   make engine ENGINE_TARGET=/Volumes/ExternalStorage/cargo-targets/mold-macos-ffi
# (`ENGINE_TARGET` in the environment works too; this used to BE that path,
# and `make engine` simply failed on every other Mac -- review 05-M17.)
ENGINE_TARGET ?= $(CURDIR)/rust/target
ENGINE_LIB := $(ENGINE_TARGET)/release/libmold_macos_ffi.a

engine: ## Build mold's Rust engine and link it into the app
	@command -v cargo >/dev/null || { echo "cargo not found -- run inside 'nix develop'"; exit 1; }
	@# Same deployment target as the app, or every object file warns.
	@cd $(ENGINE_DIR) && CARGO_TARGET_DIR=$(ENGINE_TARGET) CARGO_BUILD_JOBS=8 \
	  MACOSX_DEPLOYMENT_TARGET=26.0 cargo build --release --features metal
	@$(MAKE) engine-config
	@echo "  engine linked: $(ENGINE_LIB)"

engine-config: ## Point Engine.xcconfig at a built staticlib, or clear it
	@# The link line is cargo's own answer (`--print native-static-libs`), not a
	@# guess: fdk-aac is a C library the Rust archive does NOT bundle, so
	@# omitting it fails at link with five undefined AAC symbols.
	@if [ -f "$(ENGINE_LIB)" ]; then \
	  fdk=$$(find $(ENGINE_TARGET)/release/build -name 'libfdk-aac.a' -print -quit 2>/dev/null); \
	  fdkdir=$${fdk:+-L$$(dirname $$fdk)}; \
	  printf '%s\n' \
	    '// Generated by `make engine`. Do not edit.' \
	    'MOLD_ENGINE_LIB = $(ENGINE_LIB)' \
	    "OTHER_LDFLAGS = \$$(inherited) \$$(MOLD_ENGINE_LIB) $$fdkdir -lfdk-aac -lc++ -lobjc -liconv -lm -framework Metal -framework Foundation -framework CoreFoundation -framework IOKit -framework SystemConfiguration" \
	    'SWIFT_ACTIVE_COMPILATION_CONDITIONS = $$(inherited) MOLD_EMBEDDED_ENGINE' \
	    > Engine.xcconfig; \
	  echo "  Engine.xcconfig -> linked"; \
	else \
	  printf '%s\n' '// Generated by `make engine-config`. No engine built; remote-only.' > Engine.xcconfig; \
	  echo "  Engine.xcconfig -> remote only"; \
	fi

engine-clean: ## Unlink the engine and go back to a remote-only build
	@printf '%s\n' '// Generated by `make engine-config`. No engine built; remote-only.' > Engine.xcconfig
	@echo "  engine unlinked"

gen: ## Regenerate Mold.xcodeproj from project.yml
	@command -v $(XCODEGEN) >/dev/null || { echo "xcodegen not found -- run inside 'nix develop'"; exit 1; }
	@# A fresh checkout has no Engine.xcconfig (it is generated, ignored), and
	@# xcodegen refuses the spec without it -- remote-only until `make engine`.
	@[ -f Engine.xcconfig ] || $(MAKE) engine-clean
	@$(XCODEGEN) generate --spec project.yml --quiet

build: gen ## Build the app
	@$(XCB) build | grep -Ev '^\s*$$' | tail -5

run: build ## Build and launch the app
	@open "$(APP)"

# TMPDIR carries its trailing slash on macOS; `or` covers a shell that has none.
UAT_HOME ?= $(or $(TMPDIR),/tmp/)mold-native-uat

uat: build ## Launch against a throwaway prefs domain and a throwaway mold home
	@# Everything this run touches is disposable, so a UAT can exercise
	@# onboarding, a first launch and an empty library without costing anyone
	@# their machine list, their models or their prints. `make run` is the
	@# opposite by design: it uses the real settings and the real home.
	@defaults delete io.utensils.mold.native.fresh 2>/dev/null || true
	@# The throwaway SECRETS too -- `SecretStore.applicationSupport` swaps to
	@# the `.fresh` directory under MOLD_NATIVE_FRESH, and a UAT that inherits
	@# the previous run's engine key is not a first launch (Lane E's note).
	@rm -rf "$$HOME/Library/Application Support/io.utensils.mold.native.fresh"
	@rm -rf "$(UAT_HOME)" && mkdir -p "$(UAT_HOME)"
	@echo "  prefs: io.utensils.mold.native.fresh (emptied, including its secrets)"
	@echo "  home:  $(UAT_HOME) (emptied -- the engine starts here with no models)"
	@# Absolute, so `macos-uat`'s `pkill -f` pattern can match this argv
	@# and reap the previous run (review F6).
	@MOLD_NATIVE_FRESH=1 MOLD_HOME="$(UAT_HOME)" \
	  "$(BUILD)/$(CONFIG)/Mold Studio.app/Contents/MacOS/Mold"

test: gen ## Run every test bundle: the package, then the app's own store tests
	@# The release path's testable scripts. They synthesise what a remote-only
	@# build cannot produce -- /nix/store load commands, a Sparkle framework,
	@# a placeholder update key -- so every fail-closed arm is exercised
	@# without a 40-minute engine build or a signing identity.
	@scripts/tests/linkage-fixup.sh
	@scripts/tests/sparkle-key-gate.sh
	@scripts/tests/sparkle-signing-order.sh
	@scripts/tests/appcast-recipe.sh
	@scripts/tests/notarize-credentials.sh
	@scripts/tests/release-names.sh
	@scripts/tests/app-icon-tracked.sh
	@scripts/tests/app-icon-gate.sh
	@scripts/tests/dmg-volume-icon.sh
	@scripts/tests/prune-native-nightly.sh
	@scripts/tests/native-workflows-parse.sh
	@cd Packages/MoldClient && swift test
	@cd Packages/MoldStyle && swift test
	@# pipefail, or the grep/tail pair answers 0 for a failed run and the gate
	@# passes on a red suite.
	@# Every failing test and its issue, then the verdict -- `tail -5` alone
	@# hid WHICH three of 758 failed (CI, 2026-09-18).
	@set -o pipefail; $(XCB) -destination 'platform=macOS,arch=arm64' test \
	  | grep -E '✘|recorded an issue|Expectation failed|error:|Test run with|TEST (SUCCEEDED|FAILED)'

lint: lint-layers lint-color lint-size lint-type-size lint-a11y ## Run every architecture lint

lint-layers: ## MoldClient stays UI-free; only the root may build a backend
	@# MoldStyle is the design system and of course imports SwiftUI. MoldClient
	@# is the wire layer: it must stay usable from tests and from a CLI, so a UI
	@# import there is the violation worth catching.
	@! grep -rlnE '^import (SwiftUI|AppKit)' Packages/MoldClient/Sources \
	  || { echo "LAYER VIOLATION: MoldClient imports a UI framework"; exit 1; }
	@! grep -rln 'HTTPBackend(' Sources --include='*.swift' \
	  | grep -v 'HostStore+Reachability.swift' \
	  || { echo "LAYER VIOLATION: a backend is constructed outside the composition root"; exit 1; }
	@# One decoder configures snake_case conversion. A bare JSONDecoder()
	@# silently decodes every multi-word field as nil rather than failing.
	@! grep -rn 'JSONDecoder()' Sources Packages/*/Sources Packages/*/Tests --include='*.swift' \
	  | grep -v 'MoldJSON.swift' \
	  || { echo "DECODER VIOLATION: use MoldJSON.decoder"; exit 1; }
	@# URLSession's `.lines` drops empty lines, and an empty line is what ends an
	@# SSE frame. `moldLines()` is the accumulator that keeps them.
	@! grep -rn 'bytes\.lines' Packages/MoldClient/Sources --include='*.swift' \
	  || { echo "SSE VIOLATION: use bytes.moldLines()"; exit 1; }
	@echo "  layers ok"

lint-color: ## No literal colors -- the system owns the palette
	@! grep -rnE 'Color\((red|hue|white):|Color\(hex' Sources Packages/*/Sources --include='*.swift' \
	  || { echo "COLOR VIOLATION: use a semantic color or a material"; exit 1; }
	@echo "  color ok"

lint-size: ## Advisory: flag files over 150 lines
	@find Sources Packages/*/Sources -name '*.swift' -exec wc -l {} + \
	  | awk '$$1 > 150 && $$2 != "total" { print "  large: " $$2 " (" $$1 " lines)" }'

# A type's size is the sum of Type.swift and every Type+Concern.swift beside
# it. Splitting a 400-line type into three files does not make it smaller, and
# `lint-size` alone cannot see that.
TYPE_MAX ?= 600

lint-type-size: ## Advisory: flag a type whose files together exceed $(TYPE_MAX) lines
	@find Sources Packages/*/Sources -name '*.swift' -exec wc -l {} + \
	  | awk -v max=$(TYPE_MAX) '$$2 != "total" { \
	      name = $$2; sub(/.*\//, "", name); sub(/\.swift$$/, "", name); sub(/\+.*$$/, "", name); \
	      total[name] += $$1 } \
	    END { for (t in total) if (total[t] > max) \
	      printf "  large type: %s (%d lines across its files)\n", t, total[t] }' \
	  | sort

lint-a11y: ## Every file with a systemName image must name or opt out of it
	@# A per-site grep cannot be honest about which glyph carries a label --
	@# a same-line rule is mostly false positives, and a scan window misses
	@# a sibling @ViewBuilder or falls for a NEIGHBOUR's `.help(` (design S7,
	@# M7). This is a per-FILE floor: a file with a symbol in it must also
	@# carry a real label somewhere, or say by name why the glyph needs
	@# none. It cannot see whether the modifier actually reaches the right
	@# view -- that is still a human call, not this rule's.
	@fail=0; \
	for f in $$(grep -rl 'Image(systemName:' Sources/Mold --include='*.swift'); do \
	  if ! grep -qE 'accessibilityLabel|\.help\(|Label\(|Label \{|accessibilityElement|// a11y:' "$$f"; then \
	    echo "  no VoiceOver label and no // a11y: opt-out: $$f"; \
	    fail=1; \
	  fi; \
	done; \
	if [ "$$fail" = 1 ]; then exit 1; fi
	@echo "  a11y ok"

# ONE source of truth, `project.yml`'s MARKETING_VERSION -- which is what the
# bundle actually reports. It was duplicated here as a second literal, so
# `make release` could name a DMG after a version the app inside it did not
# claim (review 05-L4).
#
# `?=`, so a nightly can override it -- and overriding it moves the BUNDLE's
# version and the DMG's name together, which is the whole point: the
# distribution workflow sets this one variable and nothing else. It reaches
# xcodebuild through `XCB` below, so `CFBundleShortVersionString` is what the
# artifact around it claims. `?=` also honours the environment, so exporting
# it once covers `signed`, `dmg` and `notarize` in one go.
MARKETING_VERSION ?= $(shell awk -F'"' '/MARKETING_VERSION:/ { print $$2; exit }' project.yml)
VERSION ?= $(MARKETING_VERSION)
# `native` in the name because this DMG shares a GitHub release with the Tauri
# app's `Mold_<ver>_aarch64.dmg` and the CLI's `Mold-macos-arm64.dmg`. Three
# Molds on one release page is only confusing if they are not saying which.
DMG_NAME ?= Mold-native-$(VERSION).dmg
DIST := $(CURDIR)/dist
RELEASE_APP := $(BUILD)/Release/Mold Studio.app

# `release` used to depend on nothing that builds the engine, and
# Engine.xcconfig is gitignored -- so a fresh clone notarized a remote-only
# client and said nothing (05-H4). Say ALLOW_REMOTE_ONLY=1 to mean it.
ifeq ($(ALLOW_REMOTE_ONLY),1)
ENGINE_PREREQ :=
else
ENGINE_PREREQ := engine
endif

signed: $(ENGINE_PREREQ) ## Release build, signed for distribution (needs MOLD_SIGN_IDENTITY)
	@CONFIG=Release $(MAKE) build
ifneq ($(ALLOW_REMOTE_ONLY),1)
	@scripts/assert-embedded-engine.sh "$(RELEASE_APP)"
endif
	@# A Release that cannot verify an update must not ship. Debug never runs
	@# this and has no updater at all.
	@scripts/assert-sparkle-key.sh "$(RELEASE_APP)"
	@# An icon set whose images never reached the runner builds green with a
	@# generic icon; the first nightly shipped that way.
	@scripts/assert-app-icon.sh "$(RELEASE_APP)"
	@# BEFORE signing: `install_name_tool` invalidates a signature, so the
	@# order is not a preference. Fails closed on a surviving /nix/store ref.
	@scripts/fix-macos-native-linkage.sh "$(RELEASE_APP)"
	@scripts/sign-release.sh "$(RELEASE_APP)"

dmg: ## Package the signed app as a DMG
	@mkdir -p $(DIST)
	@scripts/create-dmg.sh "$(RELEASE_APP)" "$(DIST)/$(DMG_NAME)"

notarize: ## Notarize and staple the DMG
	@scripts/notarize-release.sh "$(DIST)/$(DMG_NAME)"

release: signed dmg notarize ## Sign, package and notarize in one go
	@echo "released: $(DIST)/$(DMG_NAME)"

# One channel's feed. `APPCAST_DIR` holds the archives Sparkle should offer --
# a DMG per version, plus whatever deltas `generate_appcast` decides to make.
# Stable assets live under their own `vX.Y.Z` release (immutable); nightly
# assets live under the rolling `latest` prerelease.
APPCAST_CHANNEL ?= stable
APPCAST_DIR ?= $(DIST)/updates
# The release the ASSETS live on, which is not this app's to choose: stable
# rides release.yml's `v*` release (the repository version, not this app's)
# and nightly rides desktop.yml's rolling `latest` prerelease. CI always
# passes this; the default below is only a sane local guess.
APPCAST_TAG ?= $(if $(filter nightly,$(APPCAST_CHANNEL)),latest,v$(VERSION))

appcast: ## Generate and sign a channel's appcast (needs MOLD_NATIVE_SPARKLE_KEY)
	@scripts/make-appcast.sh \
	  --channel $(APPCAST_CHANNEL) \
	  --updates-dir "$(APPCAST_DIR)" \
	  --download-url-prefix "https://github.com/utensils/mold/releases/download/$(APPCAST_TAG)/"

clean: ## Remove build output and the generated project
	@rm -rf $(BUILD) $(PROJECT) $(DIST) Packages/*/.build
