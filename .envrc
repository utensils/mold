#!/usr/bin/env bash
# direnv config for mold. Optimised for fast shell entry via nix-direnv.
#
# Without nix-direnv, `use flake` re-evaluates the flake on every cd into
# the project (~10 s warm on this repo on macOS). nix-direnv overrides
# `use flake` with a version that hashes flake.nix + flake.lock and
# caches the resolved environment in .direnv/, so subsequent entries
# load in ~50–200 ms.
#
# The pin below is upstream's recommended self-bootstrap pattern: if the
# user already has nix-direnv installed (e.g. via home-manager —
# `programs.direnv.nix-direnv.enable = true;`), the `has` guard skips
# the network fetch entirely. Otherwise direnv downloads 3.1.1 once and
# caches it under ~/.config/direnv/.
#
# Bump the version + SRI hash together by running:
#   curl -sL https://raw.githubusercontent.com/nix-community/nix-direnv/X.Y.Z/direnvrc \
#     | openssl dgst -sha256 -binary | openssl base64 -A
if ! has nix_direnv_version || ! nix_direnv_version 3.1.1; then
  source_url \
    "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.1/direnvrc" \
    "sha256-p+fzQdrms/hDa7g+soShAybJNo4bN4SIAeSfqNKgD5I="
fi

use flake
